<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No permissions are declared at all — deliberately, and notably no
      INTERNET. The whole analysis runs offline inside a WebView loading a
      bundled asset, so the app is structurally incapable of sending your
      writing anywhere. CI fails the build if that ever stops being true.
    -->

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_hemingway"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hemingway">

        <!--
          Load-bearing, not decoration. A freshly installed app stays in
          Android's "stopped" state until the user opens it once, and a stopped
          app's components are skipped when the system resolves intents. With no
          launcher activity there was no way to open the app at all, so its
          PROCESS_TEXT activity never became eligible for the selection toolbar.
        -->
        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          PROCESS_TEXT puts this app in the floating toolbar that appears when
          you select text in ANY app. The label is what shows there, so it is
          kept short, and an explicit icon is set because that toolbar renders
          icon-and-label and can skip entries it cannot draw.
        -->
        <activity
            android:name=".ProcessTextActivity"
            android:exported="true"
            android:icon="@drawable/ic_hemingway"
            android:label="@string/process_text_label"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

    </application>

</manifest>
