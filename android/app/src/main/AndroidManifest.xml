<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      SYSTEM_ALERT_WINDOW is the only permission declared, and it is what lets
      the feedback panel float above other apps. Notably absent: INTERNET. The
      analysis runs offline inside a WebView loading a bundled asset, so the app
      is structurally incapable of sending your writing anywhere — verifiable
      with `aapt dump permissions`, and CI fails the build if that ever changes.

      The accessibility service is not a permission; it is granted by switching
      the service on in system settings.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hemingway">

        <!--
          The launcher entry. Beyond explaining the two grants, having any
          launcher activity matters: a freshly installed app stays in Android's
          "stopped" state until the user opens it once, and components of a
          stopped app are skipped when the system resolves intents. Without this
          there was no way to launch the app at all, which is the likeliest
          reason Hemingway never appeared in the text-selection toolbar.
        -->
        <activity
            android:name=".SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          PROCESS_TEXT puts this app in the floating toolbar that appears when
          you select text in ANY app. android:label is what shows there, so it
          is kept short.
        -->
        <activity
            android:name=".ProcessTextActivity"
            android:exported="true"
            android:label="@string/process_text_label"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          Live as-you-type feedback. BIND_ACCESSIBILITY_SERVICE is enforced by
          the system so only Android itself can bind this.
        -->
        <service
            android:name=".HemingwayAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
