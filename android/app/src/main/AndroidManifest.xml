<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No permissions are declared at all — deliberately, and notably no
      INTERNET. The whole analysis runs offline inside a WebView loading a
      bundled asset, so the app is structurally incapable of sending your
      writing anywhere. CI fails the build if that ever stops being true.
    -->

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_hemingway"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hemingway">

        <!--
          The launcher entry, and the fallback for apps whose own selection menu
          offers no way to reach us — paste into it instead.

          Also load-bearing: a freshly installed app stays in Android's
          "stopped" state until opened once, and a stopped app's components are
          skipped when the system resolves intents. Without this the
          PROCESS_TEXT entry below never appeared at all.
        -->
        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Two ways in from other apps, because no single one covers them all:

          PROCESS_TEXT puts Hemingway in the floating toolbar Android shows when
          you select text. It is the better path — only it can write edited text
          back — but it only appears in apps that use the system selection menu.

          SEND covers apps that draw their own selection menu, so never show a
          PROCESS_TEXT entry, but do offer Share. Obsidian is the case that
          prompted this.

          Dialog-themed so it floats over the app you were writing in rather
          than replacing it.
        -->
        <activity
            android:name=".ProcessTextActivity"
            android:exported="true"
            android:icon="@drawable/ic_hemingway"
            android:label="@string/process_text_label"
            android:theme="@style/Theme.Hemingway.Dialog"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

    </application>

</manifest>
