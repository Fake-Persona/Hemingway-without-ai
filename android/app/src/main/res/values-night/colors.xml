<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark palette, selected automatically when the phone is in dark mode.

  Dot colours are lifted slightly in brightness compared to the light variant:
  the mid-tones that read well on white go muddy against a dark panel.
-->
<resources>
    <color name="panel_bg">#1D2025</color>
    <color name="panel_scrim">#2B2F36</color>
    <color name="panel_text">#E7E9EC</color>
    <color name="panel_text_dim">#9AA3AF</color>
    <color name="row_bg">#262A31</color>

    <color name="dot_adverb">#6FB6E8</color>
    <color name="dot_passive">#8FCB5C</color>
    <color name="dot_complex">#C57FD6</color>
    <color name="dot_hard">#E8C34A</color>
    <color name="dot_very_hard">#E88585</color>
</resources>
