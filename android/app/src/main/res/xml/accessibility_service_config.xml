<?xml version="1.0" encoding="utf-8"?>
<!--
  Scoped as narrowly as the feature allows: only text-change, focus and
  selection events, and only the text-retrieval capability. It does not request
  the ability to perform gestures or read window content wholesale.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewTextChanged|typeViewFocused|typeViewTextSelectionChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="150" />
